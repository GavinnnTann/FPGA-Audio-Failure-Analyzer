# Copy this file to .env.local and fill in your values.
# For Vercel: add these in Project Settings → Environment Variables.

# ── Cloud path (optional) ─────────────────────────────────────────────────────
# The Supabase project is currently disabled, so the dashboard defaults to
# USB / Web Serial only and works with no cloud connection at all.
#
# To bring the cloud path back (telemetry history, ESP32 WiFi uploads, and
# multi-device spectrogram viewing), set this to exactly "true" and make sure
# the two vars below point at a live project. Any other value — or a missing
# var — keeps the dashboard in local-only mode.
NEXT_PUBLIC_SUPABASE_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=https://zzbyxiopztiyryhvkera.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_jwt_here
